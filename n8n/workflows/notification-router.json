          }
        ]
      ]
    },
    "Fetch User Details": {
      "main": [
        [
          {
            "node": "Build Notification Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Notification Context": {
      "main": [
        [
          {
            "node": "Switch by Event Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch by Event Type": {
      "main": [
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Insert Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Notification": {
      "main": [
        [
          {
            "node": "Has Push Token?",
            "type": "main",
