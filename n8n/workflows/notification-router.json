{
  "name": "Notification Router",
  "nodes": [
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "parameters": {
        "path": "notification-route",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "notification-route"
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000002",
      "name": "Respond Immediately",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [500, 500],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Notification routed\" }",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000003",
      "name": "Validate & Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst validEventTypes = ['task_overdue', 'meeting_reminder', 'follow_up_due', 'missed_call'];\n\nconst eventType = body.event_type;\nconst userId = body.user_id;\nconst organizationId = body.organization_id;\nconst referenceId = body.reference_id || null;\nconst referenceType = body.reference_type || null;\nconst metadata = body.metadata || {};\n\nif (!eventType || !validEventTypes.includes(eventType)) {\n  throw new Error('Invalid event_type: must be one of ' + validEventTypes.join(', '));\n}\n\nif (!userId) {\n  throw new Error('Missing required field: user_id');\n}\n\nif (!organizationId) {\n  throw new Error('Missing required field: organization_id');\n}\n\nreturn [{\n  json: {\n    event_type: eventType,\n    user_id: userId,\n    organization_id: organizationId,\n    reference_id: referenceId,\n    reference_type: referenceType,\n    metadata: metadata\n  }\n}];"
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000004",
      "name": "Fetch User Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/users?id=eq.{{ $json.user_id }}&select=id,full_name,email,expo_push_token,notification_preferences",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000005",
      "name": "Build Notification Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300],
      "parameters": {
        "jsCode": "const users = $input.first().json;\nconst data = $('Validate & Extract').first().json;\n\nconst user = Array.isArray(users) && users.length > 0 ? users[0] : users;\n\nif (!user || !user.id) {\n  throw new Error('User not found for id: ' + data.user_id);\n}\n\nconst prefs = user.notification_preferences || {};\nconst pushEnabled = prefs.push_enabled !== false;\n\n// Template-based title/body mapping by event_type\nconst templates = {\n  task_overdue: {\n    title: 'Task Overdue' + (data.metadata.title ? ': ' + data.metadata.title : ''),\n    body: data.metadata.title\n      ? 'Your task \"' + data.metadata.title + '\" is past due' + (data.metadata.due_date ? ' (due ' + new Date(data.metadata.due_date).toLocaleDateString() + ')' : '') + '. Please update its status.'\n      : 'You have an overdue task that needs attention.',\n    category: 'task'\n  },\n  meeting_reminder: {\n    title: 'Meeting Reminder' + (data.metadata.event_title ? ': ' + data.metadata.event_title : ''),\n    body: data.metadata.event_title\n      ? '\"' + data.metadata.event_title + '\" starts ' + (data.metadata.starts_in || 'soon') + (data.metadata.location ? ' at ' + data.metadata.location : '') + '.'\n      : 'You have an upcoming meeting.',\n    category: 'calendar'\n  },\n  follow_up_due: {\n    title: 'Follow-Up Due',\n    body: data.metadata.action\n      ? 'Action needed: ' + data.metadata.action\n      : 'You have a follow-up item that is due.',\n    category: 'follow_up'\n  },\n  missed_call: {\n    title: 'Missed Call' + (data.metadata.caller_name ? ' from ' + data.metadata.caller_name : ''),\n    body: data.metadata.caller_name\n      ? 'You missed a call from ' + data.metadata.caller_name + (data.metadata.caller_phone ? ' (' + data.metadata.caller_phone + ')' : '') + '.'\n      : 'You have a missed call.',\n    category: 'call'\n  }\n};\n\nconst template = templates[data.event_type];\n\nreturn [{\n  json: {\n    event_type: data.event_type,\n    user_id: user.id,\n    user_name: user.full_name,\n    organization_id: data.organization_id,\n    reference_id: data.reference_id,\n    reference_type: data.reference_type,\n    metadata: data.metadata,\n    expo_push_token: user.expo_push_token,\n    push_enabled: pushEnabled,\n    notification_title: template.title,\n    notification_body: template.body,\n    category: template.category\n  }\n}];"
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000006",
      "name": "Switch by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1250, 300],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "task_overdue",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-task-overdue",
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "task_overdue",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "meeting_reminder",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-meeting-reminder",
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "meeting_reminder",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "follow_up_due",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-follow-up-due",
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "follow_up_due",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "missed_call",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-missed-call",
                    "leftValue": "={{ $json.event_type }}",
                    "rightValue": "missed_call",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "allMatchingOutputs": false
        }
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000007",
      "name": "Insert Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notifications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"organization_id\": \"{{ $json.organization_id }}\",\n  \"user_id\": \"{{ $json.user_id }}\",\n  \"title\": {{ JSON.stringify($json.notification_title) }},\n  \"body\": {{ JSON.stringify($json.notification_body) }},\n  \"channel\": \"push\",\n  \"category\": \"{{ $json.category }}\",\n  \"reference_type\": \"{{ $json.reference_type || $json.category }}\",\n  \"reference_id\": {{ $json.reference_id ? '\"' + $json.reference_id + '\"' : 'null' }}\n}",
        "options": {}
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000008",
      "name": "Has Push Token?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1750, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-push-token",
              "leftValue": "={{ $('Build Notification Context').item.json.expo_push_token }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "condition-push-enabled",
              "leftValue": "={{ $('Build Notification Context').item.json.push_enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000009",
      "name": "Send Expo Push",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 200],
      "parameters": {
        "method": "POST",
        "url": "https://exp.host/--/api/v2/push/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"to\": \"{{ $('Build Notification Context').item.json.expo_push_token }}\",\n  \"title\": {{ JSON.stringify($('Build Notification Context').item.json.notification_title) }},\n  \"body\": {{ JSON.stringify($('Build Notification Context').item.json.notification_body) }},\n  \"data\": {\n    \"type\": \"{{ $('Build Notification Context').item.json.event_type }}\",\n    \"reference_id\": \"{{ $('Build Notification Context').item.json.reference_id }}\",\n    \"category\": \"{{ $('Build Notification Context').item.json.category }}\"\n  },\n  \"sound\": \"default\"\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "n1b2c3d4-8888-4000-8000-000000000010",
      "name": "Log Event",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [2250, 300],
      "parameters": {
        "source": "database",
        "workflowId": "={{ $env.EVENT_LOGGER_WORKFLOW_ID }}",
        "workflowInputs": {
          "value": {
            "event_type": "=notification.{{ $('Build Notification Context').item.json.event_type }}",
            "source_workflow": "notification-router",
            "organization_id": "={{ $('Build Notification Context').item.json.organization_id }}",
            "payload": "={{ { event_type: $('Build Notification Context').item.json.event_type, user_id: $('Build Notification Context').item.json.user_id, reference_id: $('Build Notification Context').item.json.reference_id } }}"
          }
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
